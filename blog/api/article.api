type TagVo {
    Name string `json:"name"`
    Slug string `json:"slug"`
}

type ArticleSummary {
    Id          int64   `json:"id"`
    Title       string  `json:"title"`
    Slug        string  `json:"slug"`
    Summary     string  `json:"summary,optional"`
    CoverUrl    string  `json:"coverUrl,optional"`
    Views       int64   `json:"views"`
    IsTop       int    `json:"isTop"`
    PublishedAt string  `json:"publishedAt"`
    Tags        []TagVo `json:"tags"`
}

type ArticleDetail {
    Id          int64  `json:"id"`
    Title       string `json:"title"`
    Slug        string `json:"slug"`
    Summary     string  `json:"summary,optional"`
    Content     string  `json:"content"`
    CoverUrl    string  `json:"coverUrl,optional"`
    Status      int     `json:"status"` // 0=草稿 1=发布 2=隐藏；公开详情恒为 1，后台详情才是真实值
    Views       int64   `json:"views"`
    IsTop       int    `json:"isTop"`
    PublishedAt string  `json:"publishedAt"`
    Tags        []TagVo `json:"tags"`
}

type ArticleListReq {
    Page    int    `form:"page,default=1"`
    Size    int    `form:"size,default=10"`
    Keyword string `form:"keyword,optional"`
    Tag     string `form:"tag,optional"` // 按标签 slug 过滤
}

type ArticleListResp {
    List  []ArticleSummary `json:"list"`
    Total int64            `json:"total"`
}

// 路径参数必须声明成 Req 类型，否则 goctl 生成的 logic 拿不到 slug
type ArticleDetailReq {
    Slug string `path:"slug"`
}

type ArticleSaveReq {
    Title    string `json:"title"`
    Slug     string `json:"slug"`
    Summary  string `json:"summary,optional"`
    Content  string `json:"content"`
    CoverUrl string   `json:"coverUrl,optional"`
    Status   int      `json:"status,default=0"` // 0=草稿 1=发布 2=隐藏
    IsTop    *int     `json:"isTop,optional"`  // 1=置顶 0=取消；不传=不动（避免写作页保存误清置顶）
    Tags     []string `json:"tags,optional"`    // 标签名列表；不存在的标签自动创建
}

// 更新专用：id 走 URL 路径。不能和 ArticleSaveReq 共用一个带 path 标签的 Id 字段——
// go-zero 的 httpx.Parse 在 POST /articles（路径里没有 :id）上会因找不到路径变量直接报错，
// 表现为所有新建请求 0.2ms 内返回 50000「服务器开小差了」且不写任何 SQL
type ArticleUpdateReq {
    Id       int64    `path:"id"`
    Title    string   `json:"title"`
    Slug     string   `json:"slug"`
    Summary  string   `json:"summary,optional"`
    Content  string   `json:"content"`
    CoverUrl string   `json:"coverUrl,optional"`
    Status   int      `json:"status,default=0"`
    IsTop    *int     `json:"isTop,optional"`
    Tags     []string `json:"tags,optional"`
}

@server (
    group:  public
    prefix: /v1
)
service blog-api {
    @handler ArticleList
    get /articles (ArticleListReq) returns (ArticleListResp)

    @handler ArticleDetail
    get /articles/:slug (ArticleDetailReq) returns (ArticleDetail)
}