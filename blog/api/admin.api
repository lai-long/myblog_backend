type AdminArticleListReq {
    Page   int `form:"page,default=1"`
    Size   int `form:"size,default=10"`
    Status int `form:"status,default=-1"` // -1=全部 0=草稿 1=发布 2=隐藏（不用 optional：0 和"不传"分不开）
}

// 路径参数必须声明成 Req 类型，否则 goctl 生成的 logic 拿不到 id
type ArticleIdReq {
    Id int64 `path:"id"`
}

// 后台列表比公开列表多带 status / updatedAt，方便管理
type AdminArticleSummary {
    Id          int64  `json:"id"`
    Title       string `json:"title"`
    Slug        string `json:"slug"`
    Status      int    `json:"status"`
    Views       int64  `json:"views"`
    PublishedAt string `json:"publishedAt"`
    UpdatedAt   string `json:"updatedAt"`
}

type AdminArticleListResp {
    List  []AdminArticleSummary `json:"list"`
    Total int64                 `json:"total"`
}

type UploadResp {
    Url string `json:"url"`
}

type CommentAuditReq {
    Id     int64 `path:"id"`
    Status int   `json:"status"` // 1=通过 2=垃圾
}

// 路径参数必须声明成 Req 类型，否则 goctl 生成的 logic 拿不到 id
type CommentIdReq {
    Id int64 `path:"id"`
}

// 后台评论列表：审核前得先看到有哪些评论
type AdminCommentListReq {
    Page   int `form:"page,default=1"`
    Size   int `form:"size,default=10"`
    Status int `form:"status,default=-1"` // -1=全部 0=待审核 1=通过 2=垃圾
}

type AdminComment {
    Id           int64  `json:"id"`
    ArticleId    int64  `json:"articleId"`
    ArticleTitle string `json:"articleTitle"`
    ArticleSlug  string `json:"articleSlug"`
    ParentId     int64  `json:"parentId"`
    Nickname     string `json:"nickname"`
    Content      string `json:"content"`
    Status       int    `json:"status"`
    CreatedAt    string `json:"createdAt"`
}

type AdminCommentListResp {
    List  []AdminComment `json:"list"`
    Total int64          `json:"total"`
}

@server (
    jwt:    Auth
    group:  admin
    prefix: /v1/admin
)
service blog-api {
    // 文章管理
    @handler AdminArticleList
    get /articles (AdminArticleListReq) returns (AdminArticleListResp)

    @handler ArticleCreate
    post /articles (ArticleSaveReq) returns (EmptyResp)

    @handler ArticleUpdate
    put /articles/:id (ArticleSaveReq) returns (EmptyResp)

    @handler ArticleDelete
    delete /articles/:id (ArticleIdReq) returns (EmptyResp)

    // 图片上传
    @handler Upload
    post /upload returns (UploadResp)

    // 站点设置
    @handler AdminSiteConfigSave
    put /site/config (SiteConfigSaveReq) returns (EmptyResp)

    // 评论管理
    @handler AdminCommentList
    get /comments (AdminCommentListReq) returns (AdminCommentListResp)

    @handler CommentAudit
    put /comments/:id (CommentAuditReq) returns (EmptyResp)

    @handler CommentDelete
    delete /comments/:id (CommentIdReq) returns (EmptyResp)

    // 账号设置
    @handler ProfileGet
    get /profile returns (ProfileResp)

    @handler ProfileSave
    put /profile (ProfileSaveReq) returns (EmptyResp)

    @handler PasswordChange
    put /password (PasswordReq) returns (EmptyResp)

    // 访问统计
    @handler VisitStats
    get /stats returns (VisitStatsResp)
}
// 访问统计：PV=页面浏览次数（每次浏览一行），UV=按 天+IP哈希 去重的访客数
type DayStat {
    Date string `json:"date"`
    Pv   int64  `json:"pv"`
    Uv   int64  `json:"uv"`
}

type VisitStatsResp {
    TodayPv int64     `json:"todayPv"`
    TodayUv int64     `json:"todayUv"`
    TotalPv int64     `json:"totalPv"`
    TotalUv int64     `json:"totalUv"`
    Trend   []DayStat `json:"trend"` // 最近 7 天，按日期升序
}
